# Attiva il profilo compact, che applica i limiti iniziali definiti in Compose.
# Copiare in .env e cambiare tutti i valori CHANGE_ME.
COMPOSE_PROFILES=compact
GBRAIN_IMAGE_TAG=0.1.0
GBRAIN_ENVIRONMENT=development
GBRAIN_LOG_LEVEL=INFO
GBRAIN_PUBLIC_URL=http://localhost:8000
# Opt-in esplicito; vietato in production. Non disabilita autenticazione/CSRF e non collega servizi.
GBRAIN_DEMO_MODE=false
GBRAIN_SESSION_TTL_SECONDS=43200
GBRAIN_SESSION_SECURE_COOKIE=false

# Solo il web viene pubblicato e per default esclusivamente su loopback.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8000

# Percorsi locali di sviluppo separati; sostituibili senza assumere mount NAS.
DATA_DIR=./runtime/data
CACHE_DIR=./runtime/cache
IMPORT_DIR=./runtime/import
BACKUP_DIR=./runtime/backup

POSTGRES_DB=gbrain
POSTGRES_USER=gbrain

# Valori dimostrativi, non segreti reali. Sostituirli prima dell'avvio.
# Compose li monta nei container come secret file in /run/secrets.
GBRAIN_POSTGRES_PASSWORD=CHANGE_ME_dev_postgres_password
GBRAIN_AUTH_SECRET=CHANGE_ME_with_at_least_32_random_characters
GBRAIN_NEO4J_PASSWORD=CHANGE_ME_dev_neo4j_password

# Gmail è opzionale: senza secret file la pagina resta "non configurato".
# Istruzioni e override Compose opt-in: docs/GMAIL_OAUTH_SETUP.md.
# GBRAIN_GMAIL_OAUTH_CLIENT_SECRET_FILE=./secrets/gmail-oauth-client.json
# GBRAIN_GMAIL_TOKEN_ENCRYPTION_KEY_FILE=./secrets/gmail-token-key.txt
# GBRAIN_GMAIL_OAUTH_REDIRECT_URI=http://localhost:8000/api/gmail/oauth/callback
