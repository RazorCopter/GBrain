# Attiva il profilo compact, che applica i limiti iniziali definiti in Compose.
# Copiare in .env e cambiare tutti i valori CHANGE_ME.
COMPOSE_PROFILES=compact
GBRAIN_IMAGE_TAG=0.1.0
GBRAIN_ENVIRONMENT=development
GBRAIN_LOG_LEVEL=INFO
GBRAIN_PUBLIC_URL=http://localhost:8000
# Opt-in esplicito; vietato in production. Non disabilita autenticazione/CSRF e non collega servizi.
GBRAIN_DEMO_MODE=false
GBRAIN_SESSION_TTL_SECONDS=43200
GBRAIN_SESSION_SECURE_COOKIE=false

# Solo il web viene pubblicato e per default esclusivamente su loopback.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8000

# Percorso base host/LXC opzionale (es. mount da NAS Synology: /mnt/synology_docker/GBrain).
# Se valorizzato, fa da fallback unificato per tutti i percorsi sottostanti:
# ${GBRAIN_HOST_STORAGE_PATH}/data, cache, import, backup, postgres, neo4j.
GBRAIN_HOST_STORAGE_PATH=/mnt/synology_docker/GBrain

# Percorsi di storage persistente per container applicativo e worker (UID 10001:10001).
# I percorsi predefiniti usano la forma singolare coerente con le directory fisiche sul NAS:
DATA_DIR=/mnt/synology_docker/GBrain/data
CACHE_DIR=/mnt/synology_docker/GBrain/cache
IMPORT_DIR=/mnt/synology_docker/GBrain/import
BACKUP_DIR=/mnt/synology_docker/GBrain/backup

# Percorsi storage database (separati per isolamento permessi POSIX: PostgreSQL UID 999 chmod 700; Neo4j UID 7474).
# Raccomandato: cartelle dedicate di primo livello (/mnt/synology_docker/GBrain/postgres e neo4j).
# Se si preferiscono sottocartelle interne a data, impostare: /mnt/synology_docker/GBrain/data/postgres
POSTGRES_DATA_DIR=/mnt/synology_docker/GBrain/postgres
NEO4J_DATA_DIR=/mnt/synology_docker/GBrain/neo4j
NEO4J_LOGS_DIR=/mnt/synology_docker/GBrain/neo4j/logs
SECRETS_DIR=/mnt/synology_docker/GBrain/secrets

POSTGRES_DB=gbrain
POSTGRES_USER=gbrain

# Valori dimostrativi, non segreti reali. Sostituirli prima dell'avvio.
# Compose li monta nei container come secret file in /run/secrets.
GBRAIN_POSTGRES_PASSWORD=CHANGE_ME_dev_postgres_password
GBRAIN_AUTH_SECRET=CHANGE_ME_with_at_least_32_random_characters
GBRAIN_NEO4J_PASSWORD=CHANGE_ME_dev_neo4j_password

# Gmail è opzionale: senza secret file la pagina resta "non configurato".
# Istruzioni e override Compose opt-in: docs/GMAIL_OAUTH_SETUP.md.
# Su host Synology/LXC i secret file possono risiedere in ${SECRETS_DIR} o percorso dedicato:
# GBRAIN_GMAIL_OAUTH_CLIENT_SECRET_FILE=/mnt/synology_docker/GBrain/secrets/gmail-oauth-client.json
# GBRAIN_GMAIL_TOKEN_ENCRYPTION_KEY_FILE=/mnt/synology_docker/GBrain/secrets/gmail-token-key.txt
# GBRAIN_GMAIL_OAUTH_REDIRECT_URI=http://localhost:8000/api/gmail/oauth/callback
